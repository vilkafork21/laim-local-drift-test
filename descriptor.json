{
  "id": "b9f18448-b922-4eb5-bd4f-fb86e5eeb430",
  "name": "LAIM local drift test",
  "description": "Тест на локальный дрифт запросов из llm_val",
  "fullDescription": "",
  "ui": {
    "settings": [
      {
        "page": "General",
        "title": "General",
        "components": [
          {
            "type": "form",
            "label": "Настройки теста",
            "config": {
              "components": [
                {
                  "parameter": "ann_config",
                  "label": "Конфигурация ANN",
                  "uiComponent": "input",
                  "type": "string",
                  "defaultValue": "{'create_index': {'exact': True}, 'search_query': {}}"
                },
                {
                  "parameter": "n_closest",
                  "label": "Топ ближайших запросов для выборки ANN",
                  "uiComponent": "input",
                  "type": "integer",
                  "defaultValue": 5
                },
                {
                  "parameter": "metric_agg",
                  "label": "Способ аггрегации",
                  "uiComponent": "select",
                  "type": "string",
                  "allowedValues": [
                    {
                      "Среднее по каждой колонке": "single_mean"
                    }
                  ],
                  "defaultValue": "single_mean"
                },
                {
                  "parameter": "reliability_threshold",
                  "label": "Порог близости: запрос считается непокрытым при средней близости соседей ниже",
                  "uiComponent": "input",
                  "type": "float",
                  "defaultValue": 0.2
                },
                {
                  "parameter": "uncovered_amber_share",
                  "label": "Доля непокрытых запросов для жёлтого технического сигнала",
                  "uiComponent": "input",
                  "type": "float",
                  "defaultValue": 0.3
                },
                {
                  "parameter": "uncovered_red_share",
                  "label": "Доля непокрытых запросов для красного технического сигнала",
                  "uiComponent": "input",
                  "type": "float",
                  "defaultValue": 0.5
                },
                {
                  "parameter": "min_reference_units",
                  "label": "Минимум единиц эталона",
                  "uiComponent": "input",
                  "type": "integer",
                  "defaultValue": 30
                },
                {
                  "parameter": "min_monitoring_units",
                  "label": "Минимум единиц мониторинга",
                  "uiComponent": "input",
                  "type": "integer",
                  "defaultValue": 30
                },
                {
                  "parameter": "greater_is_better",
                  "label": "Чем выше метрика, тем лучше",
                  "uiComponent": "checkbox",
                  "defaultValue": true
                },
                {
                  "parameter": "is_info",
                  "label": "Тест информативный?",
                  "uiComponent": "checkbox",
                  "defaultValue": false
                }
              ]
            }
          }
        ]
      }
    ],
    "uiResults": {
      "semaphore": {
        "port": "all_results",
        "dataKey": "color"
      }
    },
    "result": {
      "title": "Results",
      "components": [
        {
          "label": "Результат теста",
          "type": "semaphore",
          "config": {
            "datasets": [
              {
                "value": "$.all_results.color",
                "title": "$.all_results.calculated_traffic_lights.semaphore_title"
              }
            ]
          }
        },
        {
          "type": "html",
          "label": "Описание теста",
          "uiComponent": "html",
          "parameter": "$.test_description",
          "config": {
            "datasets": [
              {
                "data": "$.test_description"
              }
            ]
          }
        }
      ]
    }
  },
  "ports": [
    {
      "name": "reference_umr",
      "label": "Reference UMR",
      "in": true,
      "type": "dataframe",
      "shape": "shape_dataframe",
      "description": "Эталонный плоский laim-umr.v2",
      "required": true,
      "order": 1
    },
    {
      "name": "monitoring_umr",
      "label": "Monitoring UMR",
      "in": true,
      "type": "dataframe",
      "shape": "shape_dataframe",
      "description": "Выход monitoring_umr TDC; QA/dialogue нормализуется внутри Drift",
      "required": true,
      "order": 2
    },
    {
      "name": "monitoring_metric",
      "label": "Monitoring metric",
      "in": true,
      "type": "default",
      "shape": "shape_model",
      "description": "Валидированный контракт laim-monitoring-metric.v2",
      "required": true,
      "order": 3
    },
    {
      "name": "all_results",
      "label": "all_results",
      "in": false,
      "type": "default",
      "shape": "shape_model",
      "description": "Результаты прохождения теста; тест покрытия потока эталоном (карточка 6.3.7): informative=true, цвет — технический сигнал по доле непокрытых запросов, n_oos/n_oot/n_closest, оценка по соседям как информация",
      "order": 4
    },
    {
      "name": "test_description",
      "label": "test_description",
      "in": false,
      "type": "hidden",
      "shape": "shape_model",
      "description": "Описание теста",
      "order": 5
    }
  ],
  "script": {
    "type": "python",
    "baseImageKey": "py312-simple",
    "deployType": "docker",
    "runConfiguration": {
      "libraryDependencies": [
        "requirements.txt"
      ],
      "sourceFiles": [
        "main.py",
        "html_report_helper.py",
        "config.py",
        "giga_wraper.py",
        "llm_val/ann.py",
        "llm_val/report_helper.py",
        "llm_val/sampler.py",
        "llm_val/scorer.py",
        "llm_val/utils.py",
        "llm_val/valtest_local_drift_stability.py",
        "llm_val/valtest_metric.py",
        "laim_monitoring/__init__.py",
        "laim_monitoring/core.py"
      ],
      "functionName": "main",
      "functionParameters": [],
      "output": {
        "type": "json",
        "output": []
      }
    }
  },
  "shape": "other"
}
